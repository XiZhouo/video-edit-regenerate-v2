{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ze/core/*": ["../01-core/*"],
      "@ze/css/*": ["../03-css-rules/*"],
      "@ze/i18n": ["../05-i18n/index.ts"],
      "@mod/*": ["../02-mod/*"],
      "dompurify": ["./node_modules/dompurify"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"]
    }
  },
  "include": [
    "src",
    "../01-core/04-user-facing/01-layout/01-header"
  ],
  "exclude": ["**/*.test.ts", "../01-core/**/*.test.ts"]
}
